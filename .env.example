# Copy to .env and fill in. .env is gitignored — never commit real values.

# LLM (OpenAI-compatible: DeepSeek, OpenAI, OpenRouter, …)
# LLM_API_KEY is required. The others have sensible defaults.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# PostgreSQL — used by robbie/db.py and docker-compose.yml
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=robbie
POSTGRES_PASSWORD=robbie
POSTGRES_DB=robbie

# Only used by the one-shot Mongo -> Postgres migration script (deleted after use)
# MONGO_URI=mongodb://localhost:27017
